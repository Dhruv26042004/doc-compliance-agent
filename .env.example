# Copy to .env and fill in. Never commit .env.

# Used when running the API outside Docker (inside Docker, compose overrides it).
DATABASE_URL=postgresql+psycopg://compliance:compliance@localhost:5432/compliance

# LLM provider: gemini | groq | ollama  (used from Phase 3)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
