# Copy to .env and fill in. Never commit .env.

# Used when running the API outside Docker (inside Docker, compose overrides it).
DATABASE_URL=postgresql+psycopg://compliance:compliance@localhost:5432/compliance

# LLM: Gemini via Google AI Studio (free key at https://aistudio.google.com)
GEMINI_API_KEY=

# --- Deployment (see DEPLOY.md). Defaults suit local use; render.yaml sets the lite profile.
# FILE_STORAGE=database          # store uploads in Postgres (hosts with a throwaway disk)
# PIPELINE_FEWSHOT=false         # skip the embedding model (~200 MB) on 512 MB hosts
# DOCX_CONVERT=false             # read Word files as text when LibreOffice is absent
# CORS_ORIGINS=["https://your-app.vercel.app"]
# CORS_ORIGIN_REGEX=https://.*[.]vercel[.]app
# ADMIN_TOKEN=change-me           # public demo: upload/analyze/delete need X-Admin-Token
# ACTIVE_POLICY_VERSION=1
